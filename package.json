{
  "name": "docuhub",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && vite build --outDir dist-pages && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "preview": "vite preview",
    "start": "NODE_ENV=production node dist/server.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "build:server": "vite build && esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "build:pages": "vite build --outDir dist-pages",
    "dev:worker": "npx --yes wrangler@4.128.0 dev",
    "check:worker": "npx --yes wrangler@4.128.0 deploy --dry-run",
    "deploy:worker": "npx --yes wrangler@4.128.0 deploy",
    "test": "node --import tsx --test tests/api.test.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.19.0",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "aws4fetch": "^1.0.20",
    "dompurify": "^3.4.14",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "jose": "^6.2.10",
    "lucide-react": "^1.37.0",
    "mammoth": "^1.12.2",
    "motion": "^13.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^8.2.2"
  }
}
